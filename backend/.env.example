# Application
APP_NAME=SIEM_M365
APP_ENV=development
DEBUG=False

# Security
# Generate strong unique values before any non-local deployment.
DB_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
BACKUP_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-chars
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Database
DB_PATH=./data/db/siem_hot.db
DB_ARCHIVE_PATH=./data/db/siem_archive.db
DB_CONFIG_PATH=./data/db/siem_config.db

# Backup
BACKUP_PATH=./data/backups

# Server
HOST=127.0.0.1
PORT=5000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL=True